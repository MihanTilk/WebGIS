# Local dev: discrete vars (used only when DATABASE_URL is unset).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=asset_tracking
DB_USER=postgres
DB_PASS=change_me

# Production (Neon): set this single var instead — it takes precedence over the
# DB_* vars above. Copy the connection string from the Neon dashboard.
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
